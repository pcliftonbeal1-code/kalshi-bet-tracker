# Copy this file to ".env" and fill in real values.
# .env is listed in .gitignore, so your real keys never get committed.
# (Filled in during later stages.)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
ODDS_API_KEY=
# Optional: phone alerts. Install the free "ntfy" app, subscribe to a topic
# name nobody could guess (it works like a password), and put it here.
NTFY_TOPIC=
